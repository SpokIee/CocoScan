{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "lan-apk": {
      "extends": "base-apk",
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "api",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.49:8000"
      }
    },
    "demo-apk": {
      "extends": "base-apk",
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "demo",
        "EXPO_PUBLIC_API_URL": "http://localhost:8000"
      }
    },
    "base-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DATA_MODE": "api",
        "EXPO_PUBLIC_API_URL": "https://REPLACE-WITH-HOSTED-BACKEND"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
