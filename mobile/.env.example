# Copy to .env (Expo reads EXPO_PUBLIC_* at bundle time; restart `expo start` after changes)

# "demo"  -> clearly-labelled simulated predictions + local storage (no backend needed)
# "api"   -> talks to the FastAPI backend in ../backend
EXPO_PUBLIC_DATA_MODE=demo

# Backend base URL. On a physical Android phone use your PC's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
