# Copy to .env and adjust.
APP_NAME=CocoScan API
ENVIRONMENT=development

# PostgreSQL (SQLite fallback is used automatically when DATABASE_URL is empty)
DATABASE_URL=postgresql+psycopg://cocoscan:cocoscan@localhost:5432/cocoscan

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File storage
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10

# ML model configuration
# One of: mobilenetv3 | efficientnetb0 | resnet50
ACTIVE_MODEL=mobilenetv3
MODEL_DIR=models_store
# Predictions below this probability are returned as "uncertain"
CONFIDENCE_THRESHOLD=0.70
